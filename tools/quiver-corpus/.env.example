# Quiver corpus — local template. Never commit real values.

# Fail-closed gate. Nothing writes until this is exactly "true".
ALLOW_QUIVER_CORPUS_IMPORT=false

# The corpus database, named explicitly. This tool never falls back to DATABASE_URL —
# see src/safety.mjs for why. Use a database dedicated to the corpus, not the app's.
QUIVER_CORPUS_DATABASE_URL=postgresql://jefe:jefe@localhost:55432/jefe_corpus?schema=public

# Refuse managed hosts (Neon/Railway/AWS) unless this is explicitly "true".
QUIVER_CORPUS_ALLOW_MANAGED_DB=false

# Salt for pseudonymising customer emails. Minimum 16 characters; generate a fresh
# one per corpus so refs cannot be brute-forced back to a known email list:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
QUIVER_CORPUS_CUSTOMER_SALT=

# --- Source access (not wired yet — blocked on Metabase MCP, 2026-08-12) ---
# Read-only credentials only. Do NOT use the admin credential committed in
# quiver/lambdas/shared/redshift_database.py — it is a production admin account and
# is separately flagged for rotation.
