DATABASE_URL="postgresql://jefe:jefe@localhost:55432/jefe_dev?schema=public"
NODE_ENV=development
APP_ENV=development

# Observability / logging
# LOG_LEVEL: debug | info | warn | error | silent (default: debug in dev, info in prod)
LOG_LEVEL=debug
# LOG_FORMAT: json | pretty (default: pretty in dev, json in prod so Railway can parse it)
# LOG_FORMAT=pretty
# APP_VERSION is surfaced on /health and /ready (falls back to RAILWAY_GIT_COMMIT_SHA)
# APP_VERSION=
# ALERT_WEBHOOK_URL: Slack-compatible incoming webhook. When set, error-level logs
# are forwarded there (rate-limited, redacted). Unset = alerting disabled (no-op).
# ALERT_WEBHOOK_URL=
SHOPIFY_API_VERSION="2026-07"
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products,write_products,read_orders,write_orders,read_all_orders,read_customers,write_customers,read_customer_events,write_pixels,read_customer_merge,write_customer_merge,read_inventory,write_inventory,write_inventory_transfers,read_inventory_transfers,read_inventory_shipments,write_inventory_shipments,read_inventory_shipments_received_items,write_inventory_shipments_received_items,read_locations,write_locations,read_assigned_fulfillment_orders,write_assigned_fulfillment_orders,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders,read_third_party_fulfillment_orders,read_fulfillments,write_fulfillments,read_shipping,write_shipping,read_draft_orders,write_draft_orders,read_order_edits,write_order_edits,read_returns,write_returns,read_discounts,write_discounts,read_price_rules,write_price_rules,read_payment_terms,write_payment_terms,read_gift_cards,write_gift_cards,read_content,write_content,read_online_store_pages,read_online_store_navigation,write_online_store_navigation,read_translations,write_translations,read_locales,write_locales,read_markets,write_markets,read_marketing_events,write_marketing_events,read_metaobjects,write_metaobjects,read_metaobject_definitions,write_metaobject_definitions,read_files,write_files,read_reports,write_reports,read_privacy_settings,write_privacy_settings,read_legal_policies,read_store_credit_accounts,read_store_credit_account_transactions,write_store_credit_account_transactions
SHOP_CUSTOM_DOMAIN=
SESSION_SECRET=
ENABLE_DEV_TOOLS=true
ENABLE_DAILY_HOME=true
ENABLE_CINEMATIC_ONBOARDING=true
ENABLE_SHOPIFY_BACKFILL_LOOP=true
SHOPIFY_BACKFILL_INITIAL_DELAY_MS=5000
# Order/refund history window for backfill (only applies with the read_all_orders
# scope; Shopify caps history at 60 days without it). Default 24 months = full
# year-over-year + two seasonal cycles. Dial down for cost, up for high-value
# stores. BACKFILL_MAX_MONTHS is the hard ceiling (kept >= the window).
BACKFILL_WINDOW_MONTHS=24
BACKFILL_MAX_MONTHS=60
LLM_ENABLED=true
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-luna
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_CHAT_PROVIDER=openai
LLM_CHAT_MODEL=gpt-5.6-luna
LLM_CHAT_FALLBACK_PROVIDER=
LLM_CHAT_FALLBACK_MODEL=
LLM_CHAT_MAX_INPUT_TOKENS=18000
LLM_GROQ_MAX_INPUT_TOKENS=6000
LLM_GEMINI_MAX_INPUT_TOKENS=18000
MERCHANT_CONTEXT_V2_ENABLED=true
MERCHANT_PASSIVE_MEMORY_ENABLED=true
EPISODIC_EMBEDDING_ENABLED=true
EPISODIC_EMBEDDING_MODEL=gemini-embedding-2
EPISODIC_EMBEDDING_TIMEOUT_MS=5000
# OpenAI-compatible backup providers — DARK until keyed. To run Kimi K3 as the
# fallback: set LLM_FALLBACK_PROVIDER=kimi, LLM_FALLBACK_MODEL=kimi-k3, and a key
# below. KIMI_BASE_URL defaults to https://api.moonshot.ai/v1 (MOONSHOT_API_KEY
# also accepted). Meta Spark / other OpenAI-compatible vendors: add a registry
# entry in config.server.js (getOpenAiCompatibleProviders) — no new adapter.
# KIMI_API_KEY=your_moonshot_api_key_here
# KIMI_BASE_URL=https://api.moonshot.ai/v1
LLM_TIMEOUT_MS=30000
LLM_MAX_INPUT_TOKENS=18000
LLM_MAX_OUTPUT_TOKENS=900
LLM_MAX_RETRIES=1

# Transactional email (Resend)
# OFF by default. With ENABLE_EMAIL unset or not exactly "true", the app NEVER
# contacts Resend: sendEmail() logs "[email disabled] would send ..." and returns
# a stub. A real send requires ENABLE_EMAIL=true AND RESEND_API_KEY set AND a
# Resend-verified sender domain (see DKIM in the email handoff blockers).
ENABLE_EMAIL=false
RESEND_API_KEY=
# Visible sender. Brand persona ("Hola"), not a person, on the verified root domain.
RESEND_FROM_EMAIL="Hola <hola@mynamejefe.com>"
# Optional: Reply-To. hola@ is send-only (inbound receiving is disabled), so point
# replies at a monitored inbox — otherwise a merchant's reply has nowhere to land.
RESEND_REPLY_TO="matt@mynamejefe.com"
# Optional: base URL for the welcome email CTA + settings/unsubscribe links
# (defaults to https://app.mynamejefe.com)
EMAIL_APP_URL=
# Optional: hosted inverted logo PNG for the email header
# (defaults to https://app.mynamejefe.com/email/jefe-lockup-inverted.png)
EMAIL_LOGO_URL=
# Secret for signing one-click unsubscribe links (/e/unsubscribe). Falls back to
# SESSION_SECRET when unset; set a dedicated value in prod.
EMAIL_UNSUBSCRIBE_SECRET=

# Inbound email → Jefe (feature #15) — reply-to-your-AI, DARK by default.
# With ENABLE_INBOUND_EMAIL unset or not exactly "true", the webhook still verifies
# + records inbound but NOTHING auto-replies (it parks). Door A (jefe@ = the AI)
# runs the shared conversation brain and replies out via the ENABLE_EMAIL adapter;
# Door B (team@ = humans) forwards to RESEND_REPLY_TO. Flip on only after a reviewed
# live round-trip.
ENABLE_INBOUND_EMAIL=false
# Svix signing secret from the Resend inbound webhook (whsec_...). Until this is set
# the webhook refuses (401) — we never act on unauthenticated inbound mail.
RESEND_INBOUND_WEBHOOK_SECRET=
# The two doors, env-driven so provisioning is a config change, not a code change.
# INBOUND_AI_ADDRESS must match the address the MX/Resend inbound actually receives
# on — that may be on a subdomain (e.g. jefe@reply.mynamejefe.com) since a domain's
# MX can only point at one provider and the root already routes hola@/matt@.
INBOUND_AI_ADDRESS=jefe@mynamejefe.com
INBOUND_TEAM_ADDRESS=team@mynamejefe.com
# Visible From for AI replies (the AI persona on the verified root sending domain).
INBOUND_AI_FROM="Jefe <jefe@mynamejefe.com>"

# Channel onboarding
CHANNEL_CREDENTIAL_ENCRYPTION_SECRET=
CHANNEL_VERIFICATION_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
SLACK_OAUTH_SCOPES=chat:write,chat:write.public,channels:read,groups:read
WHATSAPP_PROVIDER=meta
META_WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token_here
META_WHATSAPP_PHONE_NUMBER_ID=your_meta_whatsapp_phone_number_id_here
META_WHATSAPP_GRAPH_VERSION=v25.0
META_WHATSAPP_VERIFICATION_TEMPLATE_NAME=jaspers_market_order_confirmation_v1
META_WHATSAPP_MESSAGE_TEMPLATE_NAME=jaspers_market_order_confirmation_v1

# Action go-live flags. Exact string "true" enables the write/query path; any
# other value keeps it dark. Keep examples safe by default.
CLEARANCE_EXECUTE_ENABLED=false
PRODUCT_STATUS_EXECUTE_ENABLED=false
LISTING_COPY_EXECUTE_ENABLED=false
INVENTORY_TRANSFER_EXECUTE_ENABLED=false
ORDER_ATTRIBUTION_INGEST_ENABLED=false

# Golden-path real development Shopify write proof. Safe by default: the runner
# refuses to write unless the explicit gate is true and the target shop is in the
# allowlist. Do not commit real Admin tokens.
JEFE_GOLDEN_PATH_SHOPIFY_WRITE_ENABLED=false
JEFE_GOLDEN_PATH_SHOPIFY_SHOP=jefe-local-store.myshopify.com
JEFE_GOLDEN_PATH_ALLOWED_SHOPS=jefe-local-store.myshopify.com
JEFE_GOLDEN_PATH_CREDENTIAL_SOURCE=db
JEFE_GOLDEN_PATH_SHOPIFY_ADMIN_ACCESS_TOKEN=
