/// Append-only activity/event log for the internal observability panel. Every
/// meaningful user or system action is one row: a type + topic + searchable
/// summary, keyed by merchant/shop. PII-free by construction (shop domain and
/// event metadata only — never customer data). Not FK-constrained on purpose:
/// it is a durable log that must survive even if a shop row is later removed.
model ActivityEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId String?  @map("merchant_id") @db.Uuid
  shopId     String?  @map("shop_id") @db.Uuid
  shopDomain String?  @map("shop_domain")
  type       String
  topic      String?
  summary    String?
  properties Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([shopId, createdAt])
  @@map("activity_events")
}

/// LLM cost/usage ledger — one row per model call. Powers per-merchant cost and
/// the margin denominator. `cost_usd` is derived from token counts via the
/// pricing table (`app/lib/llm/pricing.server.js`); pricing is PLACEHOLDER until
/// the real Gemini rates are confirmed, so absolute costs are indicative.
model LlmUsageEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId   String?  @map("merchant_id") @db.Uuid
  shopId       String?  @map("shop_id") @db.Uuid
  feature      String
  runType      String?  @map("run_type")
  runId        String?  @map("run_id")
  provider     String   @default("gemini")
  model        String
  inputTokens  Int      @map("input_tokens")
  outputTokens Int      @map("output_tokens")
  totalTokens  Int      @map("total_tokens")
  costUsd      Decimal  @map("cost_usd") @db.Decimal(12, 6)
  latencyMs    Int?     @map("latency_ms")
  status       String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([merchantId, createdAt])
  @@index([feature, createdAt])
  @@map("llm_usage_event")
}

/// Durable record of CHANGELOG.md entries the changelog watcher has seen, so a
/// deploy/restart never re-announces an entry to Slack. One row per parsed
/// entry, keyed by a content hash. `seeded` rows were present when the watcher
/// first ran (recorded, never announced) so enabling it doesn't flood the
/// channel with the whole backlog. Also the durable source a public-facing
/// changelog page can render later.
model ChangelogAnnouncement {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryHash     String   @unique @map("entry_hash")
  section       String
  title         String
  body          String
  postedToSlack Boolean  @default(false) @map("posted_to_slack")
  seeded        Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([section])
  @@map("changelog_announcements")
}

/// Execution ledger for the typed action-primitive layer (the Action Capability
/// Registry's record). One row per action run: what was approved, the autonomy
/// decision, what was written, and the measured outcome. Generic across primitives
/// via `actionType` — NOT per-action tables. Nothing writes here until an action
/// is wired + flagged on; safe to deploy empty.
model ActionExecution {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId             String                 @unique @map("run_id") @db.Uuid
  merchantId        String                 @map("merchant_id") @db.Uuid
  shopId            String                 @map("shop_id") @db.Uuid
  actionType        String                 @map("action_type") // the primitive, e.g. "price_markdown"
  actionKind        String?                @map("action_kind") // advice context, e.g. "dead_stock_clearance"
  status            String                 @default("proposed") // proposed|approved|applied|partially_applied|reverted|failed
  merchantSetting   String                 @map("merchant_setting") // "propose"|"auto" at execution time
  resolvedMode      String                 @map("resolved_mode") // "propose"|"auto" actually used
  eligibility       Json                   @default("{}") @map("eligibility_json") // {reversible,withinCap,confident,autoEligible}
  confidence        Float?
  approvedBy        String?                @map("approved_by") // merchant id, or "auto"
  approvedAt        DateTime?              @map("approved_at") @db.Timestamptz(6)
  appliedAt         DateTime?              @map("applied_at") @db.Timestamptz(6)
  revertedAt        DateTime?              @map("reverted_at") @db.Timestamptz(6)
  preview           Json                   @default("{}") @map("preview_json") // the approved preview
  proposalSummary   Json?                  @map("proposal_summary") // propose-time money summary (totals + topItems) for the Daily Home card — read back without re-running the proposal
  caps              Json?                  @map("caps_json")
  outcomeStatus     String                 @default("pending") @map("outcome_status") // pending|measured
  outcomeMeasuredAt DateTime?              @map("outcome_measured_at") @db.Timestamptz(6)
  outcome           Json?                  @map("outcome_json") // action-shaped Observe→Learn result
  error             String?
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  writes            ActionExecutionWrite[]

  @@index([merchantId, actionType, status])
  @@index([shopId, outcomeStatus])
  @@map("action_executions")
}

/// One intended write within an action run — the queryable idempotency + reversal
/// unit. `expectedFrom` is the compare-and-set source (the previewed prior value):
/// the gate refuses to write when the live value has drifted from it, and revert
/// restores from it (the authoritative undo source — parent has no reversibility
/// snapshot by design).
model ActionExecutionWrite {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  executionId    String          @map("execution_id") @db.Uuid
  targetRef      String          @map("target_ref") // generic target, e.g. variantId
  expectedFrom   Json?           @map("expected_from") // previewed prior value; CAS + revert source
  targetValueKey String          @map("target_value_key") // canonical string of the write value, for the unique key
  targetValue    Json            @map("target_value")
  status         String          @default("pending") // pending|applied|skipped_drift|failed
  appliedAt      DateTime?       @map("applied_at") @db.Timestamptz(6)
  execution      ActionExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, targetRef, targetValueKey]) // one write per run+target+value
  @@index([executionId, status])
  @@map("action_execution_writes")
}

/// The autonomy dial: the merchant's mode per action-type (the 3-mode setting Matt
/// wants — recommend / approve_execute / autonomous). The resolution layer reads this
/// to drive resolveAutonomyMode (auto vs propose vs recommend-only); the surface
/// (picker) sets + shows it. One row per (merchant, action-type); default when absent
/// is approve_execute (propose-first). Additive; no row = the default.
model ActionAutonomyPolicy {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId String   @map("merchant_id") @db.Uuid
  actionType String   @map("action_type") // e.g. "price_markdown"
  mode       String // "recommend" | "approve_execute" | "autonomous"
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([merchantId, actionType])
  @@map("action_autonomy_policies")
}
