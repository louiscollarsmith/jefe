generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Merchant {
  id                            String                              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                          String
  status                        String                              @default("active")
  createdAt                     DateTime                            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime                            @updatedAt @map("updated_at") @db.Timestamptz(6)
  shops                         Shop[]
  ledgerEvents                  LedgerEvent[]
  products                      Product[]
  variants                      Variant[]
  orders                        Order[]
  orderLineItems                OrderLineItem[]
  refunds                       Refund[]
  inventoryLevels               InventoryLevel[]
  customerIdentities            CustomerIdentity[]
  connectorAccounts             ConnectorAccount[]
  backfillStatuses              ShopBackfillStatus[]
  backfillJobs                  BackfillJob[]
  memoryBeliefs                 MerchantMemoryBelief[]
  memoryEvidence                MerchantMemoryEvidence[]
  memoryHistory                 MerchantMemoryBeliefHistory[]
  memoryRefreshRuns             MerchantMemoryRefreshRun[]
  storeUnderstandingRuns        StoreUnderstandingRun[]
  memoryConversations           MerchantMemoryConversation[]
  memoryConversationMessages    MerchantMemoryConversationMessage[]
  memoryOpenQuestions           MerchantMemoryOpenQuestion[]
  merchantInsightRuns           MerchantInsightRun[]
  merchantInsightFindings       MerchantInsightFinding[]
  merchantGoalRuns              MerchantGoalRun[]
  merchantGoalHorizons          MerchantGoalHorizon[]
  merchantPlanRuns              MerchantPlanRun[]
  merchantPlanRecommendations   MerchantPlanRecommendation[]
  channelConnections            ChannelConnection[]
  channelCredentials            ChannelCredential[]
  channelOAuthStates            ChannelOAuthState[]
  channelVerificationChallenges ChannelVerificationChallenge[]
  channelMessageDeliveries      ChannelMessageDelivery[]

  @@map("merchants")
}

model Shop {
  id                            String                              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId                    String                              @map("merchant_id") @db.Uuid
  platform                      String                              @default("shopify")
  shopDomain                    String                              @map("shop_domain")
  externalShopId                String?                             @map("external_shop_id")
  status                        String                              @default("active")
  setupStatus                   String                              @default("installed") @map("setup_status")
  historicalOrderAccess         String                              @default("unknown") @map("historical_order_access")
  availableOrderHistoryDays     Int                                 @default(0) @map("available_order_history_days")
  backfillStartedAt             DateTime?                           @map("backfill_started_at") @db.Timestamptz(6)
  backfillCompletedAt           DateTime?                           @map("backfill_completed_at") @db.Timestamptz(6)
  onboardingStartedAt           DateTime?                           @map("onboarding_started_at") @db.Timestamptz(6)
  onboardingCompletedAt         DateTime?                           @map("onboarding_completed_at") @db.Timestamptz(6)
  uninstalledAt                 DateTime?                           @map("uninstalled_at") @db.Timestamptz(6)
  welcomeEmailSentAt            DateTime?                           @map("welcome_email_sent_at") @db.Timestamptz(6)
  winbackEmailSentAt            DateTime?                           @map("winback_email_sent_at") @db.Timestamptz(6)
  goalsCompleted                Boolean                             @default(false) @map("goals_completed")
  houseRulesCompleted           Boolean                             @default(false) @map("house_rules_completed")
  cogsCompletionPercentage      Decimal                             @default(0) @map("cogs_completion_percentage") @db.Decimal(5, 2)
  cogsConfidenceLevel           String                              @default("missing") @map("cogs_confidence_level")
  onboardingMetadata            Json                                @default("{}") @map("onboarding_metadata")
  rawPayload                    Json                                @default("{}") @map("raw_payload")
  createdAt                     DateTime                            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime                            @updatedAt @map("updated_at") @db.Timestamptz(6)
  merchant                      Merchant                            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  ledgerEvents                  LedgerEvent[]
  products                      Product[]
  variants                      Variant[]
  orders                        Order[]
  orderLineItems                OrderLineItem[]
  refunds                       Refund[]
  inventoryLevels               InventoryLevel[]
  customerIdentities            CustomerIdentity[]
  connectorAccounts             ConnectorAccount[]
  backfillStatuses              ShopBackfillStatus[]
  backfillJobs                  BackfillJob[]
  memoryBeliefs                 MerchantMemoryBelief[]
  memoryEvidence                MerchantMemoryEvidence[]
  memoryHistory                 MerchantMemoryBeliefHistory[]
  memoryRefreshRuns             MerchantMemoryRefreshRun[]
  storeUnderstandingRuns        StoreUnderstandingRun[]
  memoryConversations           MerchantMemoryConversation[]
  memoryConversationMessages    MerchantMemoryConversationMessage[]
  memoryOpenQuestions           MerchantMemoryOpenQuestion[]
  merchantInsightRuns           MerchantInsightRun[]
  merchantInsightFindings       MerchantInsightFinding[]
  merchantGoalRuns              MerchantGoalRun[]
  merchantGoalHorizons          MerchantGoalHorizon[]
  merchantPlanRuns              MerchantPlanRun[]
  merchantPlanRecommendations   MerchantPlanRecommendation[]
  channelConnections            ChannelConnection[]
  channelCredentials            ChannelCredential[]
  channelOAuthStates            ChannelOAuthState[]
  channelVerificationChallenges ChannelVerificationChallenge[]
  channelMessageDeliveries      ChannelMessageDelivery[]
  emailPreferences              EmailPreference[]

  @@unique([platform, shopDomain])
  @@index([merchantId])
  @@map("shops")
}

/// Per-recipient email notification preference, keyed by shop + sha256(email).
/// No plaintext email is stored — the unsubscribe token and this table both use
/// the email hash, matching the app's PII posture. A row with unsubscribedAt set
/// means "do not send Jefe emails to this recipient".
model EmailPreference {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId         String    @map("shop_id") @db.Uuid
  emailHash      String    @map("email_hash")
  unsubscribedAt DateTime? @map("unsubscribed_at") @db.Timestamptz(6)
  source         String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  shop           Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, emailHash])
  @@index([shopId])
  @@map("email_preferences")
}

model ConnectorAccount {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId        String    @map("merchant_id") @db.Uuid
  shopId            String?   @map("shop_id") @db.Uuid
  connector         String
  accountExternalId String?   @map("account_external_id")
  status            String    @default("active")
  scopes            String[]  @default([])
  readTokenRef      String?   @map("read_token_ref")
  writeTokenRef     String?   @map("write_token_ref")
  authMetadata      Json      @default("{}") @map("auth_metadata")
  rawPayload        Json      @default("{}") @map("raw_payload")
  connectedAt       DateTime? @map("connected_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  merchant          Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  shop              Shop?     @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@unique([merchantId, connector, accountExternalId])
  @@index([shopId])
  @@map("connector_accounts")
}

model ChannelConnection {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId              String                   @map("merchant_id") @db.Uuid
  shopId                  String?                  @map("shop_id") @db.Uuid
  provider                String
  status                  String                   @default("not_connected")
  externalAccountId       String?                  @map("external_account_id")
  externalAccountName     String?                  @map("external_account_name")
  destinationId           String?                  @map("destination_id")
  destinationLabel        String?                  @map("destination_label")
  scopes                  String[]                 @default([])
  capabilities            String[]                 @default([])
  credentialRef           String?                  @map("credential_ref") @db.Uuid
  providerMetadata        Json                     @default("{}") @map("provider_metadata")
  phoneE164               String?                  @map("phone_e164")
  maskedDestination       String?                  @map("masked_destination")
  verificationStatus      String?                  @map("verification_status")
  consentStatus           String?                  @map("consent_status")
  consentedAt             DateTime?                @map("consented_at") @db.Timestamptz(6)
  consentVersion          String?                  @map("consent_version")
  connectedAt             DateTime?                @map("connected_at") @db.Timestamptz(6)
  verifiedAt              DateTime?                @map("verified_at") @db.Timestamptz(6)
  lastValidationAt        DateTime?                @map("last_validation_at") @db.Timestamptz(6)
  lastSuccessfulMessageAt DateTime?                @map("last_successful_message_at") @db.Timestamptz(6)
  lastFailureAt           DateTime?                @map("last_failure_at") @db.Timestamptz(6)
  safeErrorCode           String?                  @map("safe_error_code")
  disconnectedAt          DateTime?                @map("disconnected_at") @db.Timestamptz(6)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  merchant                Merchant                 @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  shop                    Shop?                    @relation(fields: [shopId], references: [id], onDelete: SetNull)
  messageDeliveries       ChannelMessageDelivery[]

  @@index([merchantId, provider, status])
  @@index([shopId, provider, status])
  @@index([credentialRef])
  @@map("channel_connections")
}

model ChannelCredential {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId       String   @map("merchant_id") @db.Uuid
  shopId           String?  @map("shop_id") @db.Uuid
  provider         String
  connectionId     String?  @map("connection_id") @db.Uuid
  encryptedPayload String   @map("encrypted_payload")
  keyVersion       String   @map("key_version")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  merchant         Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  shop             Shop?    @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@index([connectionId])
  @@index([merchantId, provider])
  @@index([shopId, provider])
  @@map("channel_credentials")
}

model ChannelOAuthState {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId  String    @map("merchant_id") @db.Uuid
  shopId      String?   @map("shop_id") @db.Uuid
  provider    String
  stateHash   String    @map("state_hash")
  redirectUri String    @map("redirect_uri")
  metadata    Json      @default("{}")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  merchant    Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  shop        Shop?     @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@unique([provider, stateHash])
  @@index([merchantId, provider, expiresAt])
  @@index([shopId, provider, expiresAt])
  @@map("channel_oauth_states")
}

model ChannelVerificationChallenge {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId        String    @map("merchant_id") @db.Uuid
  shopId            String?   @map("shop_id") @db.Uuid
  connectionId      String?   @map("connection_id") @db.Uuid
  provider          String
  destinationHash   String    @map("destination_hash")
  destinationMasked String    @map("destination_masked")
  codeHash          String    @map("code_hash")
  attempts          Int       @default(0)
  maxAttempts       Int       @default(5) @map("max_attempts")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt        DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  merchant          Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  shop              Shop?     @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@index([merchantId, provider, expiresAt])
  @@index([shopId, provider, expiresAt])
  @@index([connectionId])
  @@map("channel_verification_challenges")
}

model ChannelMessageDelivery {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId        String            @map("merchant_id") @db.Uuid
  shopId            String?           @map("shop_id") @db.Uuid
  connectionId      String            @map("connection_id") @db.Uuid
  provider          String
  category          String
  idempotencyKey    String            @map("idempotency_key")
  status            String            @default("pending")
  safeErrorCode     String?           @map("safe_error_code")
  providerMessageId String?           @map("provider_message_id")
  metadata          Json              @default("{}")
  sentAt            DateTime?         @map("sent_at") @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  merchant          Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  shop              Shop?             @relation(fields: [shopId], references: [id], onDelete: SetNull)
  connection        ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([merchantId, idempotencyKey])
  @@index([merchantId, provider, createdAt])
  @@index([shopId, provider, createdAt])
  @@index([connectionId, createdAt])
  @@map("channel_message_deliveries")
}

model LedgerEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId     String   @map("merchant_id") @db.Uuid
  shopId         String?  @map("shop_id") @db.Uuid
  eventType      String   @map("event_type")
  source         String
  sourceEventId  String?  @map("source_event_id")
  dedupeKey      String?  @map("dedupe_key")
  idempotencyKey String?  @map("idempotency_key")
  actorType      String?  @map("actor_type")
  actorId        String?  @map("actor_id")
  payload        Json     @default("{}")
  rawPayload     Json     @default("{}") @map("raw_payload")
  eventTs        DateTime @default(now()) @map("event_ts") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  merchant       Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  shop           Shop?    @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@unique([merchantId, dedupeKey])
  @@unique([merchantId, idempotencyKey])
  @@index([merchantId, eventType, eventTs])
  @@index([shopId, eventTs])
  @@map("ledger_events")
}

model Product {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId      String          @map("merchant_id") @db.Uuid
  shopId          String          @map("shop_id") @db.Uuid
  externalId      String          @map("external_id")
  title           String
  handle          String?
  status          String?
  vendor          String?
  productType     String?         @map("product_type")
  sourceCreatedAt DateTime?       @map("source_created_at") @db.Timestamptz(6)
  sourceUpdatedAt DateTime?       @map("source_updated_at") @db.Timestamptz(6)
  rawPayload      Json            @default("{}") @map("raw_payload")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  merchant        Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  shop            Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variants        Variant[]
  lineItems       OrderLineItem[]

  @@unique([shopId, externalId])
  @@index([merchantId])
  @@map("products")
}

model Variant {
  id                      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId              String           @map("merchant_id") @db.Uuid
  shopId                  String           @map("shop_id") @db.Uuid
  productId               String           @map("product_id") @db.Uuid
  externalId              String           @map("external_id")
  sku                     String?
  title                   String?
  price                   Decimal?         @db.Decimal(18, 2)
  currency                String?          @default("GBP")
  unitCost                Decimal?         @map("unit_cost") @db.Decimal(18, 2)
  inventoryItemExternalId String?          @map("inventory_item_external_id")
  sourceCreatedAt         DateTime?        @map("source_created_at") @db.Timestamptz(6)
  sourceUpdatedAt         DateTime?        @map("source_updated_at") @db.Timestamptz(6)
  rawPayload              Json             @default("{}") @map("raw_payload")
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  merchant                Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  shop                    Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product                 Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  lineItems               OrderLineItem[]
  inventoryLevels         InventoryLevel[]

  @@unique([shopId, externalId])
  @@index([merchantId])
  @@index([productId])
  @@map("variants")
}

model Order {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId         String          @map("merchant_id") @db.Uuid
  shopId             String          @map("shop_id") @db.Uuid
  externalId         String          @map("external_id")
  orderName          String?         @map("order_name")
  customerExternalId String?         @map("customer_external_id")
  financialStatus    String?         @map("financial_status")
  fulfillmentStatus  String?         @map("fulfillment_status")
  sourceName         String?         @map("source_name")
  shippingCountry    String?         @map("shipping_country")
  currency           String          @default("GBP")
  subtotalPrice      Decimal?        @map("subtotal_price") @db.Decimal(18, 2)
  totalPrice         Decimal?        @map("total_price") @db.Decimal(18, 2)
  totalDiscount      Decimal?        @map("total_discount") @db.Decimal(18, 2)
  totalTax           Decimal?        @map("total_tax") @db.Decimal(18, 2)
  totalShipping      Decimal?        @map("total_shipping") @db.Decimal(18, 2)
  sourceCreatedAt    DateTime?       @map("source_created_at") @db.Timestamptz(6)
  sourceUpdatedAt    DateTime?       @map("source_updated_at") @db.Timestamptz(6)
  processedAt        DateTime?       @map("processed_at") @db.Timestamptz(6)
  rawPayload         Json            @default("{}") @map("raw_payload")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  merchant           Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  shop               Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  lineItems          OrderLineItem[]
  refunds            Refund[]

  @@unique([shopId, externalId])
  @@index([merchantId, processedAt])
  @@index([shopId, processedAt])
  @@map("orders")
}

model OrderLineItem {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId          String   @map("merchant_id") @db.Uuid
  shopId              String   @map("shop_id") @db.Uuid
  orderId             String   @map("order_id") @db.Uuid
  productId           String?  @map("product_id") @db.Uuid
  variantId           String?  @map("variant_id") @db.Uuid
  externalId          String   @map("external_id")
  sku                 String?
  title               String?
  quantity            Int      @default(0)
  unitPrice           Decimal? @map("unit_price") @db.Decimal(18, 2)
  totalPrice          Decimal? @map("total_price") @db.Decimal(18, 2)
  discount            Decimal? @db.Decimal(18, 2)
  discountAllocations Json     @default("[]") @map("discount_allocations")
  rawPayload          Json     @default("{}") @map("raw_payload")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  merchant            Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  shop                Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant             Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([orderId, externalId])
  @@index([merchantId])
  @@index([shopId])
  @@index([productId])
  @@index([variantId])
  @@map("order_line_items")
}

model Refund {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId      String    @map("merchant_id") @db.Uuid
  shopId          String    @map("shop_id") @db.Uuid
  orderId         String    @map("order_id") @db.Uuid
  externalId      String    @map("external_id")
  amount          Decimal?  @db.Decimal(18, 2)
  currency        String?   @default("GBP")
  reason          String?
  sourceCreatedAt DateTime? @map("source_created_at") @db.Timestamptz(6)
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(6)
  rawPayload      Json      @default("{}") @map("raw_payload")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  merchant        Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  shop            Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([shopId, externalId])
  @@index([merchantId, processedAt])
  @@index([orderId])
  @@map("refunds")
}

model InventoryLevel {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId              String    @map("merchant_id") @db.Uuid
  shopId                  String    @map("shop_id") @db.Uuid
  variantId               String?   @map("variant_id") @db.Uuid
  inventoryItemExternalId String    @map("inventory_item_external_id")
  locationExternalId      String    @map("location_external_id")
  available               Int?
  committed               Int?
  incoming                Int?
  sourceUpdatedAt         DateTime? @map("source_updated_at") @db.Timestamptz(6)
  observedAt              DateTime  @default(now()) @map("observed_at") @db.Timestamptz(6)
  rawPayload              Json      @default("{}") @map("raw_payload")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  merchant                Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  shop                    Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variant                 Variant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([shopId, inventoryItemExternalId, locationExternalId])
  @@index([merchantId, observedAt])
  @@index([variantId])
  @@map("inventory_levels")
}

model CustomerIdentity {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId        String    @map("merchant_id") @db.Uuid
  shopId            String    @map("shop_id") @db.Uuid
  emailHash         String    @map("email_hash")
  maskedEmail       String?   @map("masked_email")
  firstSeenOrderAt  DateTime? @map("first_seen_order_at") @db.Timestamptz(6)
  lastOrderAt       DateTime? @map("last_order_at") @db.Timestamptz(6)
