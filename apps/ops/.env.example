# Local Jefe Postgres connection, matching apps/shopify/.env.example.
DATABASE_URL="postgresql://jefe:jefe@localhost:55432/jefe_dev?schema=public"

# Required. HTTP Basic auth password for the internal ops panel.
# Any username is accepted; the password must match this value.
OPS_PASSWORD="password"

# Optional. Railway sets PORT automatically; local default is 4000.
PORT=4000
