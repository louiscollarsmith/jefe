#!/usr/bin/env bash
# Structural backstop for the shared branch: no push to origin/main lands red.
# Runs the full preflight gate (typecheck / lint / test / build) and blocks the push
# if it fails. Enable once (shared across all worktrees via the common .git/config):
#
#   git config core.hooksPath .githooks
#
# Escape hatch — ONLY when you have JUST run `bash scripts/preflight.sh` green yourself
# (e.g. re-pushing after a trivial no-op amend): git push --no-verify.
set -euo pipefail

# Only gate pushes that actually update origin/main.
pushing_main=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main) pushing_main=1 ;;
  esac
done

if [ "$pushing_main" -eq 0 ]; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"

# Graceful degrade: a worktree without installed deps can't run the gate at all.
# Skip with a clear note and let CI gate — rather than failing the push and training
# everyone to `--no-verify` (which would defeat the hook for the worktrees that CAN
# run it). The full local gate still runs wherever node_modules exists.
if [ ! -d "$repo_root/apps/shopify/node_modules" ]; then
  echo "⚠ pre-push: apps/shopify/node_modules missing in this worktree — skipping local preflight; CI still gates this push." >&2
  echo "  (run: cd apps/shopify && npm ci  — to enable the fast local gate here.)" >&2
  exit 0
fi

echo "⟳ pre-push: running preflight before origin/main …"
bash "$repo_root/scripts/preflight.sh"
